+"""Simple calculator module."""
+
+
+def add(a: int, b: int) -> int:
+    """Return the sum of two integers.
+
+    Args:
+        a: First operand.
+        b: Second operand.
+
+    Returns:
+        The sum a + b.
+    """
+    return a + b
+
+
+def subtract(a: int, b: int) -> int:
+    """Return the difference of two integers."""
+    return a - b
